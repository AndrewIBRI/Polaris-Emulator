# Polaris hotel — environment variables (EasyPanel: set these in the service config)

# The domain the panel serves the hotel on (without https://).
# The WebSocket URL, asset URLs and the Origin whitelist are generated from it.
APP_DOMAIN=server-seu-hotel.exemplo.com  # EasyPanel: use $(PRIMARY_DOMAIN) no painel para auto-resolver

# MariaDB (the panel's MariaDB service — the app connects over the project network)
DB_HOST=escritorio-habbo-db
DB_PORT=3306
DB_NAME=polaris
DB_USER=polaris
DB_PASSWORD=

# JVM heap (VPS RAM dependent)
JAVA_XMX=3072m
